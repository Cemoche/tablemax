# Test-only SSH server for the tunnel tests (see docker-compose.test.yml).
# User `tunnel` logs in with password `tunnel-pass` or one of the keys generated by
# scripts/test-secrets.sh (.test-secrets/ssh/authorized_keys, mounted at /keys). The
# host keys (Ed25519 and ECDSA) come from the same script (.test-secrets/ssh/host/), so
# their fingerprints stay the same across image rebuilds.
FROM alpine:3.21
RUN apk add --no-cache openssh-server \
 && adduser -D -s /bin/sh tunnel \
 && echo 'tunnel:tunnel-pass' | chpasswd \
 && install -d -o tunnel -g tunnel -m 0700 /home/tunnel/.ssh
COPY sshd_config /etc/ssh/sshd_config
EXPOSE 22
# Keys are copied at start: authorized_keys owned by `tunnel` (StrictModes stays on;
# scripts/test-dbs.sh up copies it again, so new client keys need no restart), the host
# keys owned by root with mode 0600 (sshd refuses a readable one).
CMD ["/bin/sh", "-c", "install -o tunnel -g tunnel -m 0600 /keys/authorized_keys /home/tunnel/.ssh/authorized_keys && install -o root -g root -m 0600 /keys/host/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key && install -o root -g root -m 0600 /keys/host/ssh_host_ecdsa_key /etc/ssh/ssh_host_ecdsa_key && exec /usr/sbin/sshd -D -e"]

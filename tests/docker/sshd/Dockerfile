# Test-only SSH server for the tunnel tests (see docker-compose.test.yml).
# User `tunnel` logs in with password `tunnel-pass` or one of the keys generated by
# scripts/test-secrets.sh (.test-secrets/ssh/authorized_keys, mounted at /keys). The
# host key is generated at build time: rebuilding the image changes its fingerprint.
FROM alpine:3.21
RUN apk add --no-cache openssh-server \
 && ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key \
 && adduser -D -s /bin/sh tunnel \
 && echo 'tunnel:tunnel-pass' | chpasswd \
 && install -d -o tunnel -g tunnel -m 0700 /home/tunnel/.ssh
COPY sshd_config /etc/ssh/sshd_config
EXPOSE 22
# authorized_keys is copied at start so it is owned by `tunnel` (StrictModes stays on).
CMD ["/bin/sh", "-c", "install -o tunnel -g tunnel -m 0600 /keys/authorized_keys /home/tunnel/.ssh/authorized_keys && exec /usr/sbin/sshd -D -e"]

# Test-only sshd: password and public key logins for `tunnel`, local forwarding only.
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
AllowUsers tunnel
PermitRootLogin no
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowTcpForwarding yes
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PidFile /run/sshd.pid
# The tests open many sessions in parallel and fail logins on purpose: no throttling,
# no per-source penalties (OpenSSH 9.8+).
MaxStartups 200
PerSourcePenalties no

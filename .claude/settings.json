{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm web*)",
      "Bash(pnpm demo:db*)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(bash scripts/test-dbs.sh *)",
      "Bash(scripts/test-dbs.sh *)",
      "Bash(bash scripts/test-claude-hooks.sh*)",
      "Bash(bash scripts/check-no-secrets.sh*)",
      "Bash(docker compose -f docker-compose.test.yml up*)",
      "Bash(docker compose -f docker-compose.test.yml down*)",
      "Bash(docker compose -f docker-compose.test.yml ps*)",
      "Bash(docker compose -f docker-compose.test.yml logs*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label list*)",
      "Bash(gh run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current*)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch -m *)",
      "Bash(git switch *)",
      "Bash(git fetch)",
      "Bash(git fetch origin*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh pr close*)",
      "Bash(gh run delete*)",
      "Bash(git worktree remove*)",
      "Bash(git switch -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -C *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --receive-pack*)",
      "Bash(git * --exec=*)",
      "Bash(git * ext::*)",
      "Bash(git -c *)",
      "Bash(git * --output*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-main-edits.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "worktree": {
    "baseRef": "fresh"
  }
}

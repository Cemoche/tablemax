{
  "name": "tablemax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "scripts/test-dbs.sh up && eval \"$(scripts/test-dbs.sh env)\" && cargo test --manifest-path src-tauri/Cargo.toml",

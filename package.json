    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@uiw/react-codemirror": "^4.25.12",
    "cmdk": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12",
